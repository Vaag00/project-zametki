# Скопируйте в .env и заполните:  cp .env.example .env

# Домен сайта (без https://) и полный адрес. Домен должен указывать на IP сервера.
# Бесплатный — на duckdns.org (см. DEPLOY.md, шаг 2), например:
#   DOMAIN=vaag-ph.duckdns.org
#   SITE_URL=https://vaag-ph.duckdns.org
DOMAIN=vaag-ph.duckdns.org
SITE_URL=https://vaag-ph.duckdns.org

# Пароль для входа в админку (сайт/#admin). Длинный, не как от почты.
ADMIN_PASSWORD=

# Бот Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat id — бот сам его пришлёт, если написать ему /start (см. DEPLOY.md)
TELEGRAM_OWNER_CHAT_ID=
