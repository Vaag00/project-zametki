# Скопируйте в .env и заполните:  cp .env.example .env

# Домен сайта (без https://). DNS-запись A домена должна указывать на IP сервера.
DOMAIN=vaag-ph.ru
SITE_URL=https://vaag-ph.ru

# Пароль для входа в админку (сайт/#admin). Длинный, не как от почты.
ADMIN_PASSWORD=

# Бот Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat id — бот сам его пришлёт, если написать ему /start (см. DEPLOY.md)
TELEGRAM_OWNER_CHAT_ID=
